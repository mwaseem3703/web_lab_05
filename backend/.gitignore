# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node_modules directory (CRITICAL: Prevents uploading thousands of heavy package files)
node_modules/
backend/node_modules/
frontend/node_modules/

# Vite / React build output directories
dist
dist-ssr
build
frontend/dist/
frontend/build/

# ENVIRONMENT VARIABLES (CRITICAL: Keeps your passwords and secret keys safe!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# MacOS specific files
.DS_Store
.AppleDouble
.LSOverride

